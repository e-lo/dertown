# Der Town — environment variables
# Copy to `.env` for local dev. In production these are set in the Netlify
# dashboard (Site config → Environment variables), scoped to BOTH "Builds" and
# "Functions" so they're available at build time (import.meta.env) AND runtime
# (process.env). See docs/MONITORING.md and CUSTOMIZATION.md.

# ── Supabase (REQUIRED) ──────────────────────────────────────────────────────
# From Supabase → Project Settings → API.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_KEY=            # anon / public key (safe to expose)
SUPABASE_SERVICE_ROLE_KEY=     # secret — server-only admin access
# Local dev only: set to "true" to use a local Supabase instance instead.
USE_LOCAL_DB=

# ── Maps (REQUIRED for map views) ────────────────────────────────────────────
PUBLIC_MAPBOX_TOKEN=           # Mapbox public access token

# ── Sentry — error tracking (RECOMMENDED) ────────────────────────────────────
# Create a project in Sentry (platform: Astro) and paste its DSN. Safe to expose.
# When unset, Sentry init is skipped (no-op). See docs/MONITORING.md.
PUBLIC_SENTRY_DSN=
# Optional: enables un-minified stack traces via source-map upload at build time.
# Create at Sentry → Settings → Auth Tokens. Scope to "Builds" only.
SENTRY_AUTH_TOKEN=

# ── Site ─────────────────────────────────────────────────────────────────────
SITE=https://dertown.org       # canonical URL (used for iCal feeds / absolute links)

# ── Email (OPTIONAL — transactional + inbound ingest) ────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RECIPIENT_EMAIL=
MAILGUN_WEBHOOK_SIGNING_KEY=   # verifies inbound email-ingest webhooks

# ── AI (OPTIONAL — admin activity import) ────────────────────────────────────
ANTHROPIC_API_KEY=
