---
import Layout from '../../components/Layout.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import Disclaimer from '../../components/ui/Disclaimer.astro';
import SportTile from '../../components/families/SportTile.astro';
import { supabase } from '../../lib/supabase';
import { setPublicCache } from '@/lib/cache';
import {
  AGE_OPTIONS,
  PROGRAM_SELECT,
  getRegStatus,
  loadSignups,
  matchesAge,
  type Program,
} from '@/lib/program-listing';
import { describeSignup, type SignupGroupId, type SignupView } from '@/lib/sports-signup';

// --- URL params ---
const sportParam = Astro.url.searchParams.get('sport') ?? ''; // a `sport` value, or 'other'
const seasonParam = Astro.url.searchParams.get('season') ?? ''; // fall|winter|spring|summer|ongoing
const ageParam = Astro.url.searchParams.get('age') ?? '';

const { data, error } = await (supabase as any)
  .from('public_activities')
  .select(PROGRAM_SELECT)
  .eq('activity_hierarchy_type', 'PROGRAM')
  .eq('status', 'approved')
  .eq('activity_type', 'sports')
  .or('program_format.neq.camp,program_format.is.null')
  .order('name');
const allSports: Program[] = data ?? [];

// --- Sport options: every sport that has at least one listing ---
const OTHER = 'other';
const sportKey = (p: Program) => (p.sport ?? '').trim() || OTHER;
const sportCounts = new Map<string, number>();
for (const p of allSports) sportCounts.set(sportKey(p), (sportCounts.get(sportKey(p)) ?? 0) + 1);
const sportOptions = [...sportCounts.entries()]
  .filter(([key]) => key !== OTHER)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([key, count]) => ({ value: key, label: key, count }));
if (sportCounts.has(OTHER)) {
  sportOptions.push({ value: OTHER, label: 'Other', count: sportCounts.get(OTHER)! });
}

// --- Filtering ---
const SEASON_FLAG: Record<string, keyof Program> = {
  fall: 'is_fall',
  winter: 'is_winter',
  spring: 'is_spring',
  summer: 'is_summer',
  ongoing: 'is_ongoing',
};
let filtered = allSports;
if (sportParam) filtered = filtered.filter((p) => sportKey(p).toLowerCase() === sportParam.toLowerCase());
if (SEASON_FLAG[seasonParam]) filtered = filtered.filter((p) => p[SEASON_FLAG[seasonParam]]);
if (ageParam) filtered = filtered.filter((p) => matchesAge(p, ageParam));

// --- Groups: what parents can act on comes first (see lib/sports-signup.ts) ---
const signups = await loadSignups(filtered);
const now = new Date();
const month = now.getMonth() + 1;

function viewFor(p: Program): SignupView {
  const entries = signups.byProgram[p.id] ?? [];
  const isOpen = entries.some((e) => e.state === 'open');
  return describeSignup(p, now, {
    openLabel: isOpen ? (getRegStatus(entries)?.label ?? 'Registration open') : null,
    windows: (signups.datesByProgram[p.id] ?? []).map((r) => ({
      opens: r.registration_opens ?? null,
      closes: r.registration_closes ?? null,
    })),
  });
}
const views = new Map(filtered.map((p) => [p.id, viewFor(p)]));

const GROUPS: { id: SignupGroupId; title: string; blurb: string; icon: string }[] = [
  { id: 'now', title: 'Sign up now', blurb: 'Registration is open.', icon: 'how_to_reg' },
  {
    id: 'soon',
    title: 'Opening soon',
    blurb: 'Signups open in the next few months, or usually open now. Check with the team.',
    icon: 'schedule',
  },
  { id: 'happening', title: 'Happening now', blurb: 'In season, or year-round clubs you can join anytime.', icon: 'sports' },
  { id: 'later', title: 'Later in the year', blurb: '', icon: 'event' },
];
const groups = GROUPS.map((g) => ({
  ...g,
  programs: filtered
    .filter((p) => views.get(p.id)!.group === g.id)
    .sort((a, b) => views.get(a.id)!.sortKey - views.get(b.id)!.sortKey || a.name.localeCompare(b.name)),
})).filter((g) => g.programs.length > 0);

// --- Filter dropdown config ---
const seasons = [
  { value: '', label: 'Any season' },
  { value: 'fall', label: 'Fall' },
  { value: 'winter', label: 'Winter' },
  { value: 'spring', label: 'Spring' },
  { value: 'summer', label: 'Summer' },
  { value: 'ongoing', label: 'Year-round' },
];
const ages = AGE_OPTIONS.map((a) => (a.value ? a : { ...a, label: 'Any age' }));
const hasFilters = !!(sportParam || seasonParam || ageParam);
const selectClass =
  'w-full min-w-0 sm:w-auto rounded-md border border-gray-300 bg-white py-2 pl-2 pr-6 sm:pl-3 sm:pr-8 text-sm text-gray-800 focus:outline-none focus:ring-2 focus:ring-primary';

// Public, anonymous content: let the CDN serve repeat requests so each view
// doesn't cost a function invocation. Purge from the admin header after edits.
setPublicCache(Astro.response.headers, [], ['sport', 'season', 'age']);
---

<Layout
  title="Sports & Leagues - Families | Der Town"
  description="Youth sports teams, leagues, and lessons in the Leavenworth area — what you can sign up for now, what's opening soon, and what's in season."
>
  <div class="bg-white min-h-screen">
    <!-- Hero -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-10">
      <Breadcrumb items={[{ label: 'Activities', href: '/families/activities' }, { label: 'Sports & Leagues' }]} />
      <SectionHeader
        title="Sports & Leagues"
        icon="sports_soccer"
        text="Youth sports teams, leagues, and lessons for Leavenworth-area kids, sorted by when you can sign up."
      />
      <p class="text-gray-400 text-center text-sm mt-1">
        Also see <a href="/families/after-school-activities" class="underline">After-School Activities</a> (including school ski club)
        and <a href="/families/programs" class="underline">Programs &amp; Classes</a>.
        Data is maintained by community volunteers — <a href="mailto:dertownleavenworth@gmail.com" class="underline">let us know</a> if something is missing.
      </p>
    </div>

    <!-- Filters: three dropdowns; picking one reloads with that filter -->
    <form
      id="sport-filters"
      method="get"
      action="/families/sports"
      class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 mt-6 grid grid-cols-3 gap-2 sm:flex sm:justify-center"
    >
      <label class="sr-only" for="f-sport">Sport</label>
      <select id="f-sport" name="sport" class={selectClass}>
        <option value="">All sports ({allSports.length})</option>
        {sportOptions.map((o) => (
          <option value={o.value} selected={sportParam.toLowerCase() === o.value.toLowerCase()}>
            {o.label} ({o.count})
          </option>
        ))}
      </select>
      <label class="sr-only" for="f-season">Season</label>
      <select id="f-season" name="season" class={selectClass}>
        {seasons.map((s) => <option value={s.value} selected={seasonParam === s.value}>{s.label}</option>)}
      </select>
      <label class="sr-only" for="f-age">Age</label>
      <select id="f-age" name="age" class={selectClass}>
        {ages.map((a) => <option value={a.value} selected={ageParam === a.value}>{a.label}</option>)}
      </select>
      <noscript>
        <button type="submit" class="rounded-md bg-primary text-white px-4 py-2 text-sm font-medium">Filter</button>
      </noscript>
    </form>
    <p class="text-center text-sm text-gray-500 mt-3 mb-6">
      {filtered.length} {filtered.length === 1 ? 'listing' : 'listings'}
      {hasFilters && (
        <>
          {' · '}
          <a href="/families/sports" class="underline hover:text-gray-800">Clear filters</a>
        </>
      )}
    </p>

    {error && (
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-8">
        <div class="bg-red-50 border border-red-200 rounded-lg p-4 text-red-800 text-sm">
          <span class="material-symbols-outlined text-base align-middle mr-1">error</span>
          Unable to load sports right now. Please try again shortly.
        </div>
      </div>
    )}

    <!-- Grouped tiles -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-10">
      {groups.map((g) => (
        <section id={g.id} class="mt-8 first:mt-0">
          <h2 class="text-2xl font-bold flex items-center gap-2">
            <span class="material-symbols-outlined" aria-hidden="true">{g.icon}</span>
            {g.title}
            <span class="text-base font-normal text-gray-500">({g.programs.length})</span>
          </h2>
          {g.blurb && <p class="text-sm text-gray-600 mt-1">{g.blurb}</p>}
          <div class={`grid grid-cols-1 md:grid-cols-2 ${g.id === 'later' ? 'lg:grid-cols-3 gap-3' : 'gap-4'} mt-4`}>
            {g.programs.map((p) => (
              <SportTile program={p} view={views.get(p.id)!} signups={signups.byProgram[p.id]} month={month} />
            ))}
          </div>
        </section>
      ))}

      {!error && filtered.length === 0 && (
        <div class="text-center py-16 text-gray-400">
          <span class="material-symbols-outlined text-5xl mb-3 block">search_off</span>
          <p class="text-lg font-medium text-gray-600 mb-1">No sports match those filters</p>
          <p class="text-sm">
            Try a different season or age, or <a href="/families/sports" class="underline">see all sports</a>.
          </p>
        </div>
      )}
    </div>

    <Disclaimer />

    <div class="mt-4 text-center">
      <div class="bg-blue-green p-8">
        <h2 class="text-2xl font-semibold mb-2">Know of a team or league we're missing?</h2>
        <p class="mb-4 text-sm">Help us keep this list complete for Leavenworth families.</p>
        <a href="mailto:dertownleavenworth@gmail.com" class="inline-flex items-center px-6 py-3 border border-gray-300 text-base font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50">
          Let Us Know
        </a>
      </div>
    </div>
  </div>

  <script>
    // Apply a filter as soon as a dropdown changes, leaving empty ones out of the URL.
    const form = document.getElementById('sport-filters') as HTMLFormElement | null;
    form?.addEventListener('change', () => {
      const params = new URLSearchParams();
      for (const select of form.querySelectorAll('select')) {
        if (select.value) params.set(select.name, select.value);
      }
      const qs = params.toString();
      window.location.href = form.action + (qs ? `?${qs}` : '');
    });
  </script>
</Layout>
