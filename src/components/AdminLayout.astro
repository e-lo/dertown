---
import AdminAuthRefresh from './AdminAuthRefresh.astro';
import '../styles/global.css';
import '../styles/admin.css';

interface Props {
  title: string;
  showBack?: boolean;
  userEmail?: string;
}

const { title, showBack = true, userEmail = 'Admin' } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} - Admin - Der Town</title>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/icon?family=Material+Icons" />
  <slot name="head" />
</head>
<body class="font-sans bg-linear-to-br from-gray-50 to-gray-100 m-0 min-h-screen text-gray-900 leading-relaxed">

<div class="admin-card">
  <div class="header">
    <div class="header-left">
      <a href="/" class="admin-logo-link">
        <img class="admin-logo" src="/logo.svg" alt="Der Town Logo" />
      </a>
      <div class="header-title-section">
        <h1>{title}</h1>
        <p>Welcome, {userEmail}</p>
      </div>
    </div>
    <div class="flex gap-2 items-center">
      {showBack && (
        <a href="/admin" class="icon-btn btn-edit" aria-label="Back to Admin">
          <span class="material-symbols-outlined text-2xl">arrow_back</span>
          <span class="tooltip">Back to Dashboard</span>
        </a>
      )}
      <slot name="actions" />
      <button
        id="purge-cache-btn"
        type="button"
        class="icon-btn btn-edit"
        onclick="refreshPublicSite()"
        aria-label="Refresh public site"
      >
        <span class="material-symbols-outlined text-2xl">cloud_sync</span>
        <span class="tooltip">Refresh public site</span>
      </button>
      <button class="icon-btn logout-btn" onclick="logout()" aria-label="Logout">
        <span class="material-symbols-outlined text-2xl">exit_to_app</span>
        <span class="tooltip">Logout</span>
      </button>
    </div>
  </div>

  <slot name="modals" />
  <AdminAuthRefresh />

  <div class="section">
    <slot />
  </div>
</div>

<script is:inline>
  // The public site is CDN-cached so ordinary traffic doesn't cost a function
  // invocation per view. Edits land in the database immediately and show here
  // right away, but the public pages keep serving their cached copy until this
  // clears it. Press once after finishing a batch of edits.
  async function refreshPublicSite() {
    const btn = document.getElementById('purge-cache-btn');
    const icon = btn?.querySelector('.material-symbols-outlined');
    const tooltip = btn?.querySelector('.tooltip');
    const restore = () => {
      if (icon) icon.textContent = 'cloud_sync';
      if (tooltip) tooltip.textContent = 'Refresh public site';
      if (btn) btn.disabled = false;
    };

    if (btn) btn.disabled = true;
    if (icon) icon.textContent = 'hourglass_top';

    try {
      const response = await fetch('/api/admin/purge-cache', {
        method: 'POST',
        credentials: 'include',
      });
      const result = await response.json().catch(() => ({}));

      if (response.ok) {
        if (icon) icon.textContent = 'cloud_done';
        if (tooltip) tooltip.textContent = 'Public site refreshed';
      } else {
        if (icon) icon.textContent = 'cloud_off';
        if (tooltip) tooltip.textContent = result.error || 'Refresh failed';
      }
    } catch {
      if (icon) icon.textContent = 'cloud_off';
      if (tooltip) tooltip.textContent = 'Refresh failed — check your connection';
    }

    setTimeout(restore, 4000);
  }

  async function logout() {
    try {
      await fetch('/api/auth/logout', { method: 'POST', credentials: 'include' });
    } catch (e) {}
    window.location.href = '/';
  }
</script>
</body>
</html>
