---
// Footer signup for "This Week in Der Town". Double opt-in: the endpoint only
// emails a confirmation link; see src/pages/api/newsletter/subscribe.ts.
---

<section class="w-full max-w-md mx-auto mb-4 text-center" aria-labelledby="newsletter-signup-heading">
  <h2 id="newsletter-signup-heading" class="text-base font-semibold text-gray-900">This Week in Der Town</h2>
  <p class="text-sm text-gray-500 mb-2">Next week's events in your inbox every Thursday.</p>
  <form id="newsletter-signup" class="flex flex-col sm:flex-row gap-2" novalidate>
    <label for="newsletter-email" class="sr-only">Email address</label>
    <input
      id="newsletter-email"
      name="email"
      type="email"
      required
      autocomplete="email"
      placeholder="you@example.com"
      class="flex-1 min-w-0 rounded-md border border-gray-300 px-3 py-2 text-base text-gray-900 focus:outline-none focus:ring-2 focus:ring-indigo-500"
    />
    <div class="absolute -left-[9999px]" aria-hidden="true">
      <label for="newsletter-website">Website</label>
      <input id="newsletter-website" name="website" type="text" tabindex="-1" autocomplete="off" />
    </div>
    <button
      type="submit"
      class="rounded-md bg-indigo-600 px-4 py-2 text-base font-semibold text-white hover:bg-indigo-700 disabled:opacity-60"
    >
      Subscribe
    </button>
  </form>
  <p id="newsletter-signup-message" class="text-sm mt-2 min-h-[1.25rem]" role="status" aria-live="polite"></p>
</section>

<script>
  const form = document.getElementById('newsletter-signup') as HTMLFormElement | null;
  const message = document.getElementById('newsletter-signup-message');

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!message) return;
    const button = form.querySelector('button');
    const data = new FormData(form);
    button?.setAttribute('disabled', '');
    message.className = 'text-sm mt-2 min-h-[1.25rem] text-gray-500';
    message.textContent = 'Sending…';

    try {
      const response = await fetch('/api/newsletter/subscribe', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email: data.get('email'), website: data.get('website') }),
      });
      const result = await response.json().catch(() => ({}));
      const ok = response.ok;
      message.className = `text-sm mt-2 min-h-[1.25rem] ${ok ? 'text-green-700' : 'text-red-600'}`;
      message.textContent = result.message ?? result.error ?? (ok ? 'Check your inbox.' : 'Something went wrong.');
      if (ok) form.reset();
    } catch {
      message.className = 'text-sm mt-2 min-h-[1.25rem] text-red-600';
      message.textContent = 'Something went wrong. Please try again.';
    } finally {
      button?.removeAttribute('disabled');
    }
  });
</script>
