---
/** Bordered card for a time-sensitive offer: icon + title, body slot, and an external link. */
interface Props {
  title: string;
  icon: string;
  link: string;
  linkLabel: string;
}

const { title, icon, link, linkLabel } = Astro.props;
---

<div class="h-full bg-white border-2 border-amber-300 rounded-lg shadow-sm p-5 text-gray-800">
  <h3 class="font-semibold text-lg text-gray-900 flex items-center gap-2 mb-2">
    <span class="material-symbols-outlined text-amber-600">{icon}</span>
    {title}
  </h3>
  <div class="text-sm space-y-2 mb-3">
    <slot />
  </div>
  <a
    href={link}
    target="_blank"
    rel="noopener"
    class="inline-flex items-center gap-1 text-sm font-medium text-blue-700 hover:underline"
  >
    {linkLabel}
    <span class="material-symbols-outlined text-base">open_in_new</span>
  </a>
</div>
