---
/**
 * Callout for the free 2026–27 Leavenworth Winter Sports Club annual
 * membership offered to every Cascade School District student.
 * Remove after the 2026–27 season.
 */
const MEMBERSHIP_URL = 'https://skileavenworth.com/tickets/2026-2027-memberships';
---

<div class="bg-white border-2 border-amber-300 rounded-lg shadow-sm p-5 text-gray-800">
  <h3 class="font-semibold text-lg text-gray-900 flex items-center gap-2 mb-2">
    <span class="material-symbols-outlined text-amber-600">downhill_skiing</span>
    Free LWSC Season Pass for Every Cascade School District Student
  </h3>
  <p class="text-sm mb-2">
    For 2026–27, <strong>all K–12 students enrolled in Cascade School District schools</strong> can get a
    <strong>free Leavenworth Winter Sports Club annual membership</strong>: access to Alpine and Nordic
    skiing, snowboarding, snowshoeing, tubing, sledding, and fat biking at all LWSC venues. No GPA or
    other requirements.
  </p>
  <p class="text-sm mb-3">
    <strong>Registration is required</strong> — memberships are not issued automatically through the school
    district. A parent or guardian completes the application on the LWSC website.
  </p>
  <a
    href={MEMBERSHIP_URL}
    target="_blank"
    rel="noopener"
    class="inline-flex items-center gap-1 text-sm font-medium text-blue-700 hover:underline"
  >
    Register at skileavenworth.com
    <span class="material-symbols-outlined text-base">open_in_new</span>
  </a>
</div>
