---
/**
 * Callout for the free 2026–27 Leavenworth Winter Sports Club annual
 * membership offered to every Cascade School District student.
 * Remove after the 2026–27 season.
 */
import HighlightCallout from './ui/HighlightCallout.astro';
---

<HighlightCallout
  title="Free LWSC Season Pass for Every Cascade School District Student"
  icon="downhill_skiing"
  link="https://skileavenworth.com/tickets/2026-2027-memberships"
  linkLabel="Register at skileavenworth.com"
>
  <p>
    For 2026–27, <strong>all K–12 students enrolled in Cascade School District schools</strong> can get a
    <strong>free Leavenworth Winter Sports Club annual membership</strong>: access to Alpine and Nordic
    skiing, snowboarding, snowshoeing, tubing, sledding, and fat biking at all LWSC venues. No GPA or
    other requirements.
  </p>
  <p>
    <strong>Registration is required</strong> — memberships are not issued automatically through the school
    district. A parent or guardian completes the application on the LWSC website.
  </p>
</HighlightCallout>
