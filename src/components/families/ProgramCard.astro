---
// Matches the site's LinkBox cards (after-school, things-to-do): icon, title,
// short text, small subtext, and one status pill in the corner.
import {
  FORMAT_LABELS,
  SEASON_BADGES,
  formatAge,
  getProgramIcon,
  getRegStatus,
  type Program,
  type SignupEntry,
} from '../../lib/program-listing';

interface Props {
  program: Program;
  signups?: SignupEntry[];
  /** Optional one-line note, e.g. typical signup months. */
  hint?: string | null;
}
const { program: p, signups, hint } = Astro.props;

const regStatus = getRegStatus(signups);
const seasons = SEASON_BADGES.filter((sb) => p[sb.key]);
// One corner pill, like the hand-curated pages: live signup status wins,
// otherwise the season(s) it runs.
const pill =
  regStatus ??
  (seasons.length > 0
    ? { label: seasons.map((s) => s.label).join(' · '), color: seasons[0].color }
    : null);
const meta = [
  p.program_format ? FORMAT_LABELS[p.program_format]?.label : null,
  p.sponsoring_organization?.name,
  formatAge(p.min_age, p.max_age, p.min_grade, p.max_grade),
]
  .filter(Boolean)
  .join(' · ');
const detailsHref = `/families/programs/${p.id}`;
---

<div
  class={`group relative flex items-start p-4 bg-white rounded-lg shadow-sm hover:shadow-md transition-all duration-200 ${p.featured ? 'ring-2 ring-amber-300' : 'ring-1 ring-gray-100'}`}
>
  <span
    class="material-symbols-outlined text-2xl mr-3 mt-0.5 text-gray-600 group-hover:scale-110 transition-transform"
  >
    {getProgramIcon(p)}
  </span>
  <div class="flex-1 min-w-0">
    <div class="flex items-start justify-between gap-2">
      <h4 class="font-medium text-gray-900 leading-snug">
        <a href={detailsHref} class="after:absolute after:inset-0">{p.name}</a>
      </h4>
      {pill && (
        <span class={`status-badge status-badge--${pill.color} status-badge--md shrink-0`}>
          {pill.label}
        </span>
      )}
    </div>
    {meta && <p class="text-sm text-gray-500">{meta}</p>}
    {p.description && <p class="text-sm text-gray-600 mt-1 line-clamp-2">{p.description}</p>}
    {(p.cost || p.cost_assistance_available) && (
      <p class="text-xs text-gray-500 mt-1">
        {p.cost}
        {p.cost && p.cost_assistance_available && ' · '}
        {p.cost_assistance_available && 'Financial assistance available'}
      </p>
    )}
    {hint && <p class="text-xs text-gray-500 mt-1">{hint}</p>}
    {p.registration_link && (
      <a
        href={p.registration_link}
        target="_blank"
        class="relative z-10 inline-flex items-center gap-1 mt-2 text-sm font-medium text-primary hover:underline"
      >
        Register
        <span class="material-symbols-outlined text-sm">open_in_new</span>
      </a>
    )}
  </div>
</div>
