---
import Badge from './ui/Badge.astro';
import { formatEventDate, formatTime, isToday, getEventUrl } from '../lib/event-utils';
import { renderMarkdownPreview } from '../lib/markdown-utils';

const { event, tags } = Astro.props;

const { month: eventMonth, day: eventDay, dayOfWeek: eventDayOfWeek } = formatEventDate(event.start_date);
const eventIsToday = isToday(event.start_date);
const descriptionPreview = renderMarkdownPreview(event.description, 300);

// Always sanitize tag and provide a fallback
function toKebabCase(str: string) {
  return (str || '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
}
const primaryTag = tags && tags.primary ? toKebabCase(tags.primary) : '';
const bgClass = primaryTag ? `bg-event-${primaryTag}` : 'bg-event-default';
const textClass = 'text-white';
---

<article class={`event-list-card relative flex h-full transition-colors ${bgClass} ${textClass}`}>
  <a
    href={getEventUrl(event.id)}
    class="absolute inset-0 z-10"
    aria-label={`View details for ${event.title}`}></a>

  <div class="flex-none text-center p-4 w-24">
    <p class="text-lg font-bold opacity-80">{eventMonth}</p>
    <p class="text-5xl font-extrabold leading-tight">{eventDay}</p>
  </div>

  <div class={`relative grow min-w-0 p-4 ${event.featured ? 'pr-10' : ''}`}>
    <!-- Star for featured events -->
    {
      event.featured && (
        <div class="absolute top-4 right-4 z-20">
          <svg class="w-5 h-5 text-yellow-400 fill-current" viewBox="0 0 20 20">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
          </svg>
        </div>
      )
    }

    <!-- Main content -->
    <div class="relative z-0">
      <h3 class="text-xl font-bold mb-1 line-clamp-2 break-words" data-fit-title>{event.title}</h3>
      <p class="text-sm opacity-90 mb-2">
        <span class="font-semibold">{eventDayOfWeek}</span>
        {event.start_time ? ` · ${formatTime(event.start_time)}` : ''}
        {event.end_time ? ` - ${formatTime(event.end_time)}` : ''}
      </p>
      {descriptionPreview && <p class="text-sm opacity-70 line-clamp-3 break-words">{descriptionPreview}</p>}

      <!-- Tags -->
      <div class="flex flex-wrap gap-2 mt-3">
        {event.status === 'cancelled' && (
          <Badge variant="error" size="sm">Cancelled</Badge>
        )}
        {eventIsToday && (
          <Badge variant="today" size="sm">Today</Badge>
        )}
        {tags && tags.primary && (
          <Badge variant="white" size="sm">{tags.primary}</Badge>
        )}
        {tags && tags.secondary && (
          <Badge variant="white" size="sm">{tags.secondary}</Badge>
        )}
      </div>
    </div>
  </div>
</article>

<script>
  // Step each title down until it fits its line clamp; the longest titles also
  // get a third line. Re-fits whenever a card's width changes (resize, filter).
  const FIT_STEPS = [
    { fontSize: '1.25rem', lines: '2' },
    { fontSize: '1.125rem', lines: '2' },
    { fontSize: '1rem', lines: '2' },
    { fontSize: '1rem', lines: '3' },
    { fontSize: '0.875rem', lines: '3' },
  ];

  const fittedWidths = new WeakMap<HTMLElement, number>();

  function fitTitle(title: HTMLElement) {
    const width = title.clientWidth;
    if (width === 0 || fittedWidths.get(title) === width) return;
    fittedWidths.set(title, width);
    for (const step of FIT_STEPS) {
      title.style.fontSize = step.fontSize;
      title.style.webkitLineClamp = step.lines;
      if (title.scrollHeight <= title.clientHeight + 1) return;
    }
  }

  const observer = new ResizeObserver((entries) => {
    for (const entry of entries) fitTitle(entry.target as HTMLElement);
  });
  document.querySelectorAll<HTMLElement>('[data-fit-title]').forEach((title) => observer.observe(title));
</script>
