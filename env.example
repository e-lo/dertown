# Example env file for Der Town
# Copy to .env.local and fill in your actual secrets/keys

# --- Supabase (required for all environments) ---
# Used by Astro, Python scripts, and deployment
# Get these from Supabase dashboard (Project Settings > API or the connection widget)
PUBLIC_SUPABASE_URL=your-supabase-url-here
PUBLIC_SUPABASE_KEY=your-anon-key-here
# Only needed for admin/server-side scripts
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here  

# --- Google Analytics (optional, for production analytics) ---
# Used in src/components/Layout.astro
# Get this from Google Analytics admin panel
# GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX 

# --- Newsletter: This Week in Der Town (see EMAIL_SETUP.md) ---
# Full-access Resend key, used only for the newsletter (signup + broadcasts).
# RESEND_NEWSLETTER_API_KEY=re_xxxxxxxxxxxxx
# Segment id printed by `npm run newsletter -- create-segment`
# RESEND_NEWSLETTER_SEGMENT_ID=
# NEWSLETTER_FROM_EMAIL="This Week in Der Town <hello@dertown.org>"
# Random secret for signing confirmation links: openssl rand -base64 32
# NEWSLETTER_SIGNING_SECRET=
