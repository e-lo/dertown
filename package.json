{
  "name": "dertown",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "theme:generate": "tsx scripts/generate-theme.ts",
    "predev": "npm run theme:generate",
    "build": "astro build",
    "build:validate": "npm run validate-theme-colors && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint \"src/**/*.{js,ts,astro}\"",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "test": "tsx src/lib/__tests__/date-time-formatting.test.ts",
    "test:filtering": "tsx src/lib/__tests__/event-filtering.test.ts",
    "test:fullcalendar": "tsx src/lib/__tests__/fullcalendar-utc.test.ts",
    "test:timezone": "TZ=UTC tsx scripts/validate_timezone.mjs",
    "validate-theme-colors": "node --loader ts-node/esm scripts/validate_theme_colors.ts",
    "setup-env": "echo 'Create .env.local with: SUPABASE_URL=http://127.0.0.1:54321 and SUPABASE_ANON_KEY=your-key'",
    "test:email-ingest": "tsx src/lib/__tests__/email-ingest.test.ts",
    "test:activity-fields": "tsx src/lib/__tests__/activity-fields.test.ts",
    "test:url-normalization": "tsx src/lib/__tests__/url-normalization.test.ts",
    "test:announcement-staging": "tsx src/lib/__tests__/announcement-staging.test.ts",
    "test:deps": "tsx src/lib/__tests__/dependency-health.test.ts",
    "test:image-upload": "tsx src/lib/__tests__/event-image-upload.test.ts",
    "test:scraper-pagination": "tsx src/lib/__tests__/scraper-reference-pagination.test.ts",
    "test:scraper-ical-timezone": "TZ=America/Los_Angeles tsx src/lib/__tests__/scraper-ical-timezone.test.ts",
    "test:scraper-cascade-discovery": "tsx src/lib/__tests__/scraper-cascade-discovery.test.ts",
    "test:scraper-cascade-cards": "tsx src/lib/__tests__/scraper-cascade-cards.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@astrojs/netlify": "^7.0.13",
    "@date-fns/tz": "^1.5.0",
    "@sentry/astro": "^10.69.0",
    "@shoelace-style/shoelace": "^2.20.1",
    "astro": "^6.4.8",
    "cheerio": "^1.2.0",
    "date-fns": "^4.4.0",
    "embla-carousel": "^8.6.0",
    "js-yaml": "^4.2.0",
    "mapbox-gl": "^3.27.0",
    "marked": "^18.0.7",
    "node-ical": "^0.27.1",
    "resend": "^6.18.1",
    "rrule": "^2.8.1",
    "tablesort": "^5.7.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@supabase/supabase-js": "^2.111.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/js-yaml": "^4.0.9",
    "@types/marked": "^5.0.2",
    "astro-eslint-parser": "^1.4.0",
    "autoprefixer": "^10.5.4",
    "dotenv": "^16.5.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.8.0",
    "markdownlint-cli": "^0.49.1",
    "postcss": "^8.5.25",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "tailwindcss": "^4.3.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.1",
    "typescript-eslint": "^8.65.0"
  },
  "overrides": {
    "b4a": "1.8.1",
    "bare-events": "2.8.3",
    "bare-fs": "4.7.1",
    "bare-os": "3.9.1",
    "bare-path": "3.0.0",
    "bare-stream": "2.13.1",
    "bare-url": "2.4.3",
    "fast-fifo": "1.3.2",
    "streamx": "2.25.0",
    "text-decoder": "1.2.7"
  }
}
